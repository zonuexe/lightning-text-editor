{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "inzm-tauri",
  "version": "0.1.0",
  "identifier": "me.zonu.inzm.tauri",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "inzm — Rust + Tauri Editor",
        "width": 1024,
        "height": 700,
        "minWidth": 520,
        "minHeight": 360,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
